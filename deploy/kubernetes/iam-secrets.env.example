# Copy outside the checkout, chmod 600, and replace every value before import.
# Do not commit credentials. DATABASE_URL comes from the CNPG iam-db-app secret.
SECRET_KEY_BASE=replace-with-at-least-64-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
IAM_ADMIN_PASSWORD=replace-with-a-unique-admin-password
IAM_REGISTRATION_KEY=replace-with-the-agreed-registration-key
# Optional private Spaces bucket (endpoint/bucket/region go in iam-config):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
