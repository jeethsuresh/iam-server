FROM hexpm/elixir:1.18.5-erlang-27.3.4.17-alpine-3.21.7
RUN apk add --no-cache bash build-base git postgresql-client imagemagick imagemagick-jpeg chromium chromium-chromedriver
WORKDIR /app
ENV MIX_ENV=test PORT=4002 ERL_FLAGS="+S 2:2 +SDcpu 1 +SDio 1 +A 2" \
    CHROME_PATH=/usr/bin/chromium-browser CHROMEDRIVER_PATH=/usr/bin/chromedriver
COPY mix.exs mix.lock .formatter.exs ./
COPY config config
COPY apps apps
COPY scripts scripts
COPY test.sh ./
RUN mix local.hex --force && mix local.rebar --force && mix deps.get --only test && mix deps.compile
# Browser and server protocol versions must come from the same locked dependencies.
RUN cp deps/phoenix/priv/static/phoenix.min.js apps/lakehouse_web/priv/static/ \
    && cp deps/phoenix_live_view/priv/static/phoenix_live_view.min.js apps/lakehouse_web/priv/static/
CMD ["bash", "./test.sh"]
