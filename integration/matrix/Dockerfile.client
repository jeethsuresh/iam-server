FROM node@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
RUN mkdir -p /app
WORKDIR /app
COPY integration/matrix/package.json integration/matrix/package-lock.json ./
RUN npm ci --ignore-scripts
COPY integration/matrix/crypto.mjs ./crypto.mjs
ENV NODE_EXTRA_CA_CERTS=/fixtures/ca.pem
CMD ["node", "crypto.mjs"]
