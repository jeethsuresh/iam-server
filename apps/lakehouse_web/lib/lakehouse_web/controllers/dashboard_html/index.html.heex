<div class="dashboard-page">
  <header class="page-heading"><h1>Your services</h1></header>
  <%= for {kind, message} <- @flash do %><div role="status" class={"flash flash--#{kind}"}><%= message %></div><% end %>
  <section aria-labelledby="connected-heading" class="service-section">
    <div class="section-heading"><div><h2 id="connected-heading">Connected services <span class="count"><%= length(@directory.connected) + length(@directory.uncatalogued) %></span></h2></div><a href={~p"/settings"} class="text-link">Manage connections ↗</a></div>
    <div class="service-grid service-grid--connected" id="connected-services">
      <%= for service <- @directory.connected do %>
        <article class="service-card service-card--connected">
          <div class="card-top"><img class="service-icon service-logo" src={service.logo_url} alt="" width="44" height="44" referrerpolicy="no-referrer" /></div>
          <h3><%= service.name %></h3><div class="service-domain"><%= display_url(service.home_url) %></div><p><%= service.description %></p>
          <a href={~p"/services/#{service.id}/launch"} class="service-action account-action" data-service={service.name}>Open service <span aria-hidden="true">↗</span><span class="sr-only"> <%= service.name %></span></a>
        </article>
      <% end %>
      <%= for grant <- @directory.uncatalogued do %>
        <article class="service-card"><div class="card-top"><span class="service-icon">↗</span></div><h3><%= hostname(grant.app_origin) %></h3><p>This connection is outside the service catalog. An administrator can add its sign-in link.</p><a href={grant.app_origin} class="service-action account-action" rel="noreferrer">Visit service ↗</a></article>
      <% end %>
    </div>
    <%= if @directory.connected == [] and @directory.uncatalogued == [] do %>
      <div class="empty-state empty-state--compact"><p>Connect an available service to add it here.</p></div>
    <% end %>
  </section>
  <section aria-labelledby="available-heading" class="service-section">
    <div class="section-heading"><div><h2 id="available-heading">Available services <span class="count"><%= length(@directory.available) %></span></h2></div><%= if @current_user_is_admin do %><a href={~p"/services/manage"} class="secondary-button">+ Add a service</a><% end %></div>
    <div class="service-grid" id="available-services">
      <%= for service <- @directory.available do %>
        <article class="service-card"><div class="card-top"><img class="service-icon service-logo" src={service.logo_url} alt="" width="44" height="44" referrerpolicy="no-referrer" /></div><h3><%= service.name %></h3><div class="service-domain"><%= display_url(service.home_url) %></div><p><%= service.description %></p><a href={~p"/services/#{service.id}/launch"} class="service-action account-action" data-service={service.name}>Connect service <span aria-hidden="true">→</span><span class="sr-only"> <%= service.name %></span></a></article>
      <% end %>
    </div>
    <%= if @directory.available == [] do %><div class="empty-state empty-state--compact"><h3><%= if @directory.connected == [], do: "A home for your favorite services.", else: "You’re all connected." %></h3><p><%= if @current_user_is_admin, do: "Add an app to the shared catalog to make it available here.", else: "New services will appear here when your administrator adds them." %></p></div><% end %>
  </section>
  <p class="service-directory-link"><a href="https://apps.gravitas.cool/#apps" class="text-link">Browse apps for your devices ↗</a></p>
  <footer class="dashboard-footer"><a href={~p"/groups"}>Find your groups →</a></footer>
</div>
