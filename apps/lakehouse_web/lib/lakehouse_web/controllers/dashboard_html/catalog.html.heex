<div class="dashboard-page catalog-page">
  <header class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Service catalog</h1><p>A shared starting point for everyone on Gravitas.</p></div><a href={~p"/dashboard"} class="text-link">Back to services ↗</a></header>
  <%= for {kind, message} <- @flash do %><div role="status" class={"flash flash--#{kind}"}><%= message %></div><% end %>
  <div class="catalog-columns"><section class="catalog-form-panel"><h2>Add a service</h2><p class="muted">Choose an app that supports signing in with Gravitas.</p>
    <.form for={@form} action={~p"/services"} id="service-form">
      <label for="service-name">Service name</label><input id="service-name" type="text" name="service[name]" value={@form[:name].value} required maxlength="80" placeholder="e.g. Fieldnotes" /><span class="field-error"><%= errors(@form, :name) %></span>
      <label for="service-description">Description</label><textarea id="service-description" name="service[description]" maxlength="240" rows="3" required placeholder="What is this service for?"><%= @form[:description].value %></textarea><span class="field-error"><%= errors(@form, :description) %></span>
      <label for="service-logo">Logo URL</label><input id="service-logo" name="service[logo_url]" value={@form[:logo_url].value} required maxlength="2048" placeholder="https://notes.gravitas.cool/logo.png" /><span class="field-error"><%= errors(@form, :logo_url) %></span>
      <label for="service-home">Service URL</label><input id="service-home" name="service[home_url]" type="url" value={@form[:home_url].value} required placeholder="https://notes.gravitas.cool" /><span class="field-error"><%= errors(@form, :home_url) %></span>
      <label for="service-login">Sign-in URL</label><input id="service-login" name="service[login_url]" type="url" value={@form[:login_url].value} required placeholder="https://notes.gravitas.cool/auth/gravitas/start" /><span class="field-error"><%= errors(@form, :login_url) %></span>
      <p class="field-help">The app’s Gravitas sign-in entry point, on the same domain as the service. The app uses this to create its own secure session.</p>
      <button type="submit" class="primary-button">Add service</button>
    </.form>
  </section><section class="catalog-list-panel"><div class="section-heading"><h2>In the catalog <span class="count"><%= length(@services) %></span></h2></div>
    <%= if @services == [] do %><div class="empty-state"><h3>Room for something useful.</h3><p>Your first service will appear here and on everyone’s dashboard.</p></div><% end %>
    <%= for service <- @services do %>
      <article class="catalog-row">
        <img :if={service.logo_url} class="service-icon service-logo" src={service.logo_url} alt="" width="44" height="44" referrerpolicy="no-referrer" />
        <div><h3><%= service.name %></h3><p><%= display_url(service.home_url) %></p></div>
        <form action={~p"/services/#{service.id}/delete"} method="post"><input type="hidden" name="_csrf_token" value={get_csrf_token()} /><button type="submit" class="remove-button" aria-label={"Remove " <> service.name}>Remove</button></form>
      </article>
      <details class="catalog-branding" open={service.id == @edit_id}>
        <summary><%= if service.logo_url && service.description, do: "Edit branding", else: "Complete required branding" %></summary>
        <% form = branding_form(service, @edit_id, @edit_changeset) %>
        <.form for={form} action={~p"/services/#{service.id}/branding"} id={"branding-#{service.id}"}>
          <label for={"name-#{service.id}"}>Service name</label>
          <input id={"name-#{service.id}"} name="service[name]" value={form[:name].value} required maxlength="80" />
          <span class="field-error"><%= errors(form, :name) %></span>
          <label for={"description-#{service.id}"}>Description</label>
          <textarea id={"description-#{service.id}"} name="service[description]" required maxlength="240" rows="3"><%= form[:description].value %></textarea>
          <span class="field-error"><%= errors(form, :description) %></span>
          <label for={"logo-#{service.id}"}>Logo URL</label>
          <input id={"logo-#{service.id}"} name="service[logo_url]" value={form[:logo_url].value} required maxlength="2048" />
          <span class="field-error"><%= errors(form, :logo_url) %></span>
          <button type="submit" class="secondary-button">Save branding</button>
        </.form>
      </details>
    <% end %>
    <p class="field-help">Adding a service makes it discoverable. Each person still chooses whether to connect their account.</p>
  </section></div>
</div>
