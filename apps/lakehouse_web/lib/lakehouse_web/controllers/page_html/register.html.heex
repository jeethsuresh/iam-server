<div class="auth-page">
<h1>Create account</h1>

<%= if @error do %>
  <div class="flash flash--error" role="alert"><%= @error %></div>
<% end %>

<%= if @info do %>
  <div class="flash flash--info" role="alert"><%= @info %></div>
<% end %>

<form action={~p"/web/register"} method="post">
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <%= if @session_id != "" do %>
    <input type="hidden" name="sessionID" value={@session_id} />
  <% end %>
  <label for="username">Username</label>
  <input id="username" name="username" type="text" autocomplete="username" required maxlength="20" pattern="[a-zA-Z0-9]+" title="Letters and numbers only" value={@username} />

  <label for="password">Password</label>
  <input id="password" name="password" type="password" autocomplete="new-password" required />

  <label for="registration-key">Registration key</label>
  <input id="registration-key" name="registration_key" type="password" autocomplete="off" required />

  <button type="submit">Register</button>
</form>

<p>Already have an account? <a href={LakehouseWeb.IamAuth.login_path(@username, @session_id)}>Sign in</a></p>
</div>
