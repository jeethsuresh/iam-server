<div class="auth-page">
<h1>Sign in</h1>

<%= if @info && @info != "" do %>
  <div class="flash flash--info" role="alert"><%= @info %></div>
<% end %>

<%= if @error && @error != "" do %>
  <div class="flash flash--error" role="alert"><%= @error %></div>
<% end %>

<form action={~p"/web/login"} method="post">
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <label for="username">Username</label>
  <input id="username" name="username" type="text" autocomplete="username" placeholder="user" aria-describedby="username-help" required value={@username} />
  <p id="username-help">
    A username without a domain signs in to <strong><%= LakehouseIam.Identifier.domain() %></strong>.
    You can also use your full address, such as <strong><%= LakehouseIam.Identifier.format("user") %></strong>.
  </p>

  <label for="password">Password</label>
  <input id="password" name="password" type="password" autocomplete="current-password" required />

  <%= if @session_id != "" do %>
    <input type="hidden" name="sessionID" value={@session_id} />
    <p class="flash flash--info">Completing federated sign-in. Enter your password.</p>
  <% end %>

  <button type="submit">Sign in</button>
</form>

<p>No account? <a href={LakehouseWeb.IamAuth.registration_path(@session_id)}>Register</a></p>
</div>
