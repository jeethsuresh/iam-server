<div class="settings-page">
<h1>Settings</h1>

<%= if @flash_info && @flash_info != "" do %>
  <div class="flash flash--info" role="alert"><%= @flash_info %></div>
<% end %>

<%= if @flash_error && @flash_error != "" do %>
  <div class="flash flash--error" role="alert"><%= @flash_error %></div>
<% end %>

<section class="settings-section">
  <h2>Account</h2>
  <p>Signed in as <strong><%= @username %></strong></p>
  <p><a href={~p"/logout"}>Sign out</a></p>
</section>

<section class="settings-section">
  <h2>Password</h2>
  <form action={~p"/web/settings/password"} method="post">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <label for="current_password">Current password</label>
    <input id="current_password" name="current_password" type="password" autocomplete="current-password" required />

    <label for="new_password">New password</label>
    <input id="new_password" name="new_password" type="password" autocomplete="new-password" required />

    <label for="new_password_confirm">Confirm new password</label>
    <input id="new_password_confirm" name="new_password_confirm" type="password" autocomplete="new-password" required />

    <button type="submit">Update password</button>
  </form>
</section>

<section class="settings-section">
  <h2>Connected apps</h2>
  <%= if @connected_apps == [] do %>
    <p>No third-party apps have access.</p>
  <% else %>
    <ul class="settings-apps">
      <%= for app <- @connected_apps do %>
        <li>
          <strong><%= app.app_origin %></strong>
          <span><%= Enum.join(app.scopes, ", ") %></span>
          <span>rooms: <%= if app.room_mode == :all, do: "all", else: Enum.join(app.room_ids, ", ") %></span>
          <form action={~p"/web/settings/apps/revoke"} method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="origin" value={app.app_origin} />
            <button type="submit">Revoke</button>
          </form>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<%= if @current_user_is_admin do %>
  <section class="settings-section">
    <h2>Pending accounts</h2>

    <%= if @pending_users == [] do %>
      <p>No accounts waiting for approval.</p>
    <% else %>
      <ul class="settings-pending">
        <%= for u <- @pending_users do %>
          <li class="settings-pending__item">
            <strong><%= u.username %></strong>
            <span class="settings-pending__since">since <%= u.inserted_at %></span>
            <form action={~p"/web/admin/approve"} method="post" class="settings-pending__form">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="hidden" name="username" value={u.username} />
              <button type="submit">Approve</button>
            </form>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

<p class="settings-back"><a href={~p"/dashboard"}>← Back to services</a></p>
</div>
