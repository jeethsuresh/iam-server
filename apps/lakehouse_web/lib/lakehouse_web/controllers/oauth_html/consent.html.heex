<div class="oauth-consent">
  <h1>Authorize application</h1>
  <p>Signed in as <strong><%= @username %></strong></p>

  <section class="oauth-consent__urls">
    <p><strong>Caller URL:</strong> <code><%= @sess.caller_url %></code></p>
    <p><strong>Callback URL:</strong> <code><%= @sess.redirect_url %></code></p>
    <p><strong>App origin:</strong> <code><%= @sess.app_origin %></code></p>
  </section>

  <section>
    <h2>Permissions requested</h2>
    <ul>
      <%= for scope <- @sess.scopes do %>
        <%= if scope == "native.broker" do %>
          <li>Let Private Store sign you into apps you have already approved on this device.</li>
        <% else %>
          <li><code><%= scope %></code>
            <%= case scope do %>
              <% "groups.create" -> %> — Create new groups as you. Only new groups are added to selected access.
              <% "groups.manage" -> %> — Rename groups you own, invite or remove members, accept invitations and leave.
              <% "groups.join" -> %> — Show your invitations. Accepting one gives this app access to that group.
              <% "spaces.channels" -> %> — Access current and future channels of spaces you approve, within your chat permissions.
              <% "friends.read" -> %> — View your private friends, requests and blocked list.
              <% "friends.manage" -> %> — Send and answer friend requests, remove friends and block people.
              <% _ -> %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <form action={~p"/oauth/consent"} method="post">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="sessionID" value={@session_id} />

    <%= if "chats.read" in @sess.scopes or "chats.write" in @sess.scopes or "groups.manage" in @sess.scopes do %>
      <section>
        <h2>Chat access</h2>
        <label>
          <input type="checkbox" name="all_rooms" value="true" />
          All groups and chats (now and future)
        </label>
        <p>Or select rooms:</p>
        <ul>
          <%= for room <- @rooms do %>
            <li>
              <label>
                <input type="checkbox" name="room_ids[]" value={room.id} />
                <%= room.name || room.id %>
              </label>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <button type="submit">Allow</button>
    <a href={~p"/"}>Cancel</a>
  </form>
</div>
