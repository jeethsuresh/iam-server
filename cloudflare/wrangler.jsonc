{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iam-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "IAM_DOMAIN": "example.com",
    "IAM_PUBLIC_URL": "https://iam.example.com",
    "IAM_ADMIN_USERNAME": "admin"
  },
  "containers": [{
    "class_name": "IamContainer",
    "image": "../Dockerfile.cloudflare",
    "image_build_context": "..",
    "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": {
    "bindings": [{ "name": "IAM", "class_name": "IamContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IamContainer"] }]
}
