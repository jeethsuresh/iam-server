# Lakehouse / iam-server — Forge deploy contract
# Patterns from docs/forgefile.template.yml (Forge docs); trimmed unused options.

version: 1

project:
  name: iam-server
  compose_slug: iam-server

scripts:
  build:
    run: ./build.sh
    description: Compile via mix, or docker compose build when mix is unavailable
  test:
    run: ./test.sh --exclude-browser
    description: Run ExUnit + API BDD (browser skipped on Forge; uses compose when mix is missing)
  teardown:
    run: ./teardown.sh
    description: Stop the docker compose stack for this project

deployments:
  web:
    description: Lakehouse IAM + Matrix web app (postgres + lakehouse)
    auto_deploy: false
    scripts:
      build: build
      test: test
      deploy: ./deploy.sh
      teardown: teardown
    ports:
      - name: http
        port: 4000
        public: true

artifacts: {}

agent:
  packages: []
