FROM hexpm/elixir:1.18.5-erlang-27.3.4.17-alpine-3.21.7 AS build
RUN apk add --no-cache build-base git
WORKDIR /app
ENV MIX_ENV=prod ERL_FLAGS="+S 2:2 +SDcpu 1 +SDio 1 +A 2"
RUN mix local.hex --force && mix local.rebar --force
COPY mix.exs mix.lock .formatter.exs ./
COPY config config
COPY apps apps
RUN mix deps.get --only prod && mix deps.compile && mix compile && mix release lakehouse
# LiveView's browser protocol must match the locked server dependency.
RUN cp deps/phoenix/priv/static/phoenix.min.js _build/prod/rel/lakehouse/lib/lakehouse_web-*/priv/static/ \
    && cp deps/phoenix_live_view/priv/static/phoenix_live_view.min.js _build/prod/rel/lakehouse/lib/lakehouse_web-*/priv/static/

FROM alpine:3.21
RUN apk add --no-cache libstdc++ openssl ncurses-libs ca-certificates imagemagick imagemagick-jpeg \
    && addgroup -S -g 1000 lakehouse && adduser -S -u 1000 -G lakehouse lakehouse
WORKDIR /app
COPY --from=build --chown=lakehouse:lakehouse /app/_build/prod/rel/lakehouse ./
COPY --chmod=755 scripts/container-entrypoint.sh /usr/local/bin/iam-entrypoint
ENV PHX_SERVER=true PORT=4000 RELEASE_DISTRIBUTION=none RELEASE_TMP=/tmp HOME=/tmp ERL_CRASH_DUMP=/tmp/erl_crash.dump
USER lakehouse
EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/iam-entrypoint"]
CMD ["/app/bin/lakehouse", "start"]
